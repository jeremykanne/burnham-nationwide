---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="PermitMapper™ | Real-Time Construction Permit Intelligence" description="Search permits, track construction projects and view contractor details with real-time permit data across more than 30 major markets, free at burnhammapper.com." nav="technology">
  <div class="page-band">
    <div class="wrap">
      <ol class="crumbs"><li><a href="/">Home</a></li><li>Technology</li><li>PermitMapper™</li></ol>
      <nav aria-label="Technology"><a href="/our-technology/permit-mapper/" aria-current="page">PermitMapper™</a><a href="/our-technology/burnham-eye/">BurnhamEYE™</a></nav>
    </div>
  </div>

  <section class="page-hero">
    <div class="wrap grid grid--2 grid--center">
      <div class="stack">
        <div class="eyebrow">The Burnham PermitMapper™</div>
        <h1 class="h-display">Construction research, <span class="hl-block">simplified.</span></h1>
        <p class="lede">Real-time permit information for more than 30 major markets in one map. Search specific permits, check a project’s status and find its contacts in one place.</p>
        <div class="row">
          <a class="btn btn--primary" href="https://burnhammapper.com/">Explore burnhammapper.com</a>
          <a class="btn btn--outline" href="#data">See the data</a>
        </div>
      </div>
      <div class="media media--tall"><img src="/assets/img/services/permit-mapper.jpg" alt="Surveyors in hard hats on a construction site at sunset with a tower crane behind" width="1500" height="618"></div>
    </div>
  </section>

  <section class="section section--deep section--tight" aria-label="PermitMapper at a glance">
    <div class="wrap stats">
      <div class="stat"><div class="stat__value">30+</div><div class="stat__label">major markets with real-time permit data</div></div>
      <div class="stat"><div class="stat__value">1 map</div><div class="stat__label">for permits, project status and contacts</div></div>
      <div class="stat"><div class="stat__value">Mobile</div><div class="stat__label">optimized for searching from the field</div></div>
    </div>
  </section>

  <section class="section" id="data">
    <div class="wrap grid grid--2">
      <div class="stack">
        <div class="eyebrow">The details are in the data</div>
        <h2 class="h-section">Geo-tagged permit activity, searchable in seconds.</h2>
        <p class="lede">PermitMapper™ is Burnham’s proprietary web database for finding construction details quickly and accurately.</p>
        <p class="body">A heat map layer shows where local development is concentrated, and which firms are behind those projects.</p>
      </div>
      <div class="card">
        <h3 class="h-card">What every record includes</h3>
        <ul class="list">
          <li>Permit number, issue date and type</li>
          <li>Work descriptions</li>
          <li>Addresses</li>
          <li>PIN</li>
          <li>Contractor information</li>
          <li>Status updates and more</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="wrap grid grid--2 grid--center">
      <div class="media media--tall"><img src="/assets/img/services/due-diligence.jpg" alt="Project team members reviewing drawings at a table" width="1500" height="1000" loading="lazy"></div>
      <div class="stack">
        <div class="eyebrow">Coast-to-coast coverage</div>
        <h2 class="h-section">Work smarter with current information.</h2>
        <p class="body">PermitMapper covers nearly every major market and is growing. Use it to build your own picture of construction activity near you.</p>
        <div class="callout">
          <div class="callout__title">Help us grow the map</div>
          <div class="callout__body">We add to the database daily. If you represent a jurisdiction or know a good source of permit data, <a class="link" href="/contact/">contact our team</a> and we will integrate it.</div>
        </div>
        <p class="small">All data and search results in PermitMapper come from third-party sources and are provided “as is.” Burnham disclaims all warranties regarding their accuracy.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap cta-block">
      <div class="stack stack--sm">
        <h2>Found the permit. Need help with yours?</h2>
        <p>Burnham’s expediters and code consultants can take your project from application to approval.</p>
      </div>
      <div class="row">
        <a class="btn btn--primary" href="/contact/">Contact Burnham</a>
        <a class="btn btn--on-dark" href="https://burnhammapper.com/">Open PermitMapper</a>
      </div>
    </div>
  </section>
</BaseLayout>
