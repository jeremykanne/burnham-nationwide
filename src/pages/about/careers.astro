---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Careers" description="Build a career in permit expediting and code consulting. Burnham Nationwide is always looking for talented people to join its teams across the US." nav="about">
  <div class="page-band">
    <div class="wrap">
      <ol class="crumbs"><li><a href="/">Home</a></li><li>About</li><li>Careers</li></ol>
      <nav aria-label="About Burnham"><a href="/about/why-burnham/">Why Burnham</a><a href="/about/team/">Team</a><a href="/about/history/">History</a><a href="/about/testimonials/">Testimonials</a><a href="/about/careers/" aria-current="page">Careers</a><a href="/diversity-inclusion/">Diversity</a><a href="/about/faq/">FAQ</a></nav>
    </div>
  </div>

  <section class="page-hero">
    <div class="wrap grid grid--2 grid--center">
      <div class="stack">
        <div class="eyebrow">Careers</div>
        <h1 class="h-display">Passionate about providing special experiences?</h1>
        <p class="lede">Burnham Nationwide has supported the construction community for more than 30 years through innovation and exceptional service. Its people are its most valuable resource, and the firm is always looking for talented individuals to join teams across the country.</p>
        <div class="row"><a class="btn btn--primary" href="#apply">How to apply</a></div>
      </div>
      <div class="media media--tall"><img src="/assets/img/about/team-care.jpg" alt="Burnham team members at the ACE Mentor Program Chicago event holding an Amazing Summer Experiences Ahead sign" width="1600" height="1357"></div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="wrap stack stack--lg">
      <div class="stack stack--sm section-head">
        <div class="eyebrow">Come work with us</div>
        <h2 class="h-section">A supportive, collaborative place to do specialized work.</h2>
      </div>
      <div class="grid grid--3">
        <article class="card">
          <h3 class="h-sm">Thoughtful, specialized work</h3>
          <p class="body">Burnham provides specialized, thoughtful solutions and a personal touch on every project, from single permits to national rollouts.</p>
        </article>
        <article class="card">
          <h3 class="h-sm">A supportive environment</h3>
          <p class="body">A supportive environment is key to Burnham’s success. Its offices are filled with people who embody its core values, personally and professionally, and bring out the best in each other.</p>
        </article>
        <article class="card">
          <h3 class="h-sm">Giving back</h3>
          <p class="body">Beyond the office, Burnham is dedicated to giving back to the communities where its people live and work.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap stack stack--lg">
      <div class="stack stack--sm section-head">
        <div class="eyebrow">Our values</div>
        <h2 class="h-section">What we look for.</h2>
      </div>
      <div class="grid grid--4">
        <div class="value"><h3 class="h-sm">Caring for people</h3><p class="body">Appreciating every stakeholder and always working to support one another.</p></div>
        <div class="value"><h3 class="h-sm">Leading through innovation</h3><p class="body">Creating new and better processes.</p></div>
        <div class="value"><h3 class="h-sm">Improving productivity</h3><p class="body">Learning from experience and practicing tenacious problem solving.</p></div>
        <div class="value"><h3 class="h-sm">Perfecting customer service</h3><p class="body">Owning client satisfaction by meeting or exceeding expectations.</p></div>
      </div>
      <div class="callout" style="max-width: 900px;">
        <div class="callout__title">Bring Burnham to your city</div>
        <div class="callout__body">If you have local permitting expertise and would like to establish a Burnham office in your city, Burnham would like to hear from you.</div>
      </div>
    </div>
  </section>

  <section class="section section--flush-top" id="apply">
    <div class="wrap cta-block">
      <div class="stack stack--sm">
        <h2>Think you would be a good fit?</h2>
        <p>Burnham welcomes applications for its open positions. Get in touch and tell us about yourself and the office you are interested in.</p>
      </div>
      <div class="row">
        <a class="btn btn--primary" href="/contact/">Contact us to apply</a>
        <a class="btn btn--on-dark" href="/about/team/">Meet the team</a>
      </div>
    </div>
  </section>
</BaseLayout>
