---
import type { GetStaticPaths } from 'astro';
import BlogListing from '../../../components/BlogListing.astro';
import { BLOG, getPosts, getTopics, paginate } from '../../../lib/blog';

export const getStaticPaths = (async () => {
  const topics = await getTopics();
  return paginate(await getPosts(), true)
    .slice(1)
    .map((page) => ({ params: { page: String(page.n) }, props: { page, topics } }));
}) satisfies GetStaticPaths;

const { page, topics } = Astro.props;
---
<BlogListing
  heading="The Final Review"
  intro="News, code updates and permitting insight from the Burnham Nationwide team."
  base={BLOG}
  topics={topics}
  page={page}
/>
