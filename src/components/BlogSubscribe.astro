<section class="section" id="subscribe">
  <div class="wrap cta-block">
    <div class="stack stack--sm">
      <h2>Get The Final Review in your inbox.</h2>
      <p>A monthly roundup of code changes, permitting updates and project news.</p>
    </div>
    <form class="subscribe" action="#" method="post" aria-label="Newsletter signup">
      <label class="visually-hidden" for="subscribe-email">Email address</label>
      <input class="input" id="subscribe-email" type="email" name="email" autocomplete="email" placeholder="you@company.com" required>
      <button class="btn btn--primary" type="submit">Subscribe</button>
    </form>
  </div>
</section>
